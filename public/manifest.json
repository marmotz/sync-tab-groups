{
  "manifest_version": 3,
  "name": "Sync Tab Group",
  "description": "Synchronise les groupes d'onglets et leur contenu entre devices",
  "version": "0.1.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "sync-tab-group@marmotz",
      "strict_min_version": "139.0"
    }
  },
  "permissions": ["tabs", "tabGroups", "storage"],
  "background": {
    "scripts": ["background/index.js"],
    "type": "module"
  },
  "icons": {
    "16": "icons/icon.svg",
    "32": "icons/icon.svg",
    "48": "icons/icon.svg",
    "96": "icons/icon.svg",
    "128": "icons/icon.svg"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "Sync Tab Group",
    "default_icon": {
      "16": "icons/icon.svg",
      "32": "icons/icon.svg"
    }
  }
}
